{
  "name": "appshots",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t1llo/appShots.git"
  },
  "description": "Self-hosted App Store screenshot generator with an MCP endpoint, a web Studio and a Mac capture CLI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "appshots": "cli/appshots.mjs"
  },
  "scripts": {
    "build": "vite build",
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --test --test-concurrency=4 \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "test:render": "RENDER_TESTS=1 npm test",
    "browser": "playwright install chromium --only-shell",
    "icons": "node scripts/icons.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "check:cli": "npm run build:cli && git diff --exit-code -- cli/appshots.mjs",
    "test:cli": "node --test \"test/cli/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
