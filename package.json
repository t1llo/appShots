{
  "name": "appshots",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted App Store screenshot generator with an MCP endpoint, a web gallery and a Mac capture CLI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "appshots": "cli/appshots.mjs"
  },
  "scripts": {
    "build": "vite build",
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "browser": "playwright install chromium --only-shell"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "playwright": "1.64.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
