# Sign-in. Set all three or none: with none there is no sign-in at all, which is for localhost only.
#
# Create an OAuth client of type "Web application" in Google Cloud Console with
#   Authorised JavaScript origin:  <PUBLIC_URL>
#   Authorised redirect URI:       <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your own Google address. This account is the admin: it is always let in and keeps the server's
# existing projects. Anyone with a Google account can sign in unless the admin narrows it on the Admin page.
ADMIN_EMAIL=

# The public origin, e.g. https://appshots.example.com. Used as the Google redirect, in the links
# an agent gets back and in the skill at /skill.md. Empty falls back to each request's host.
PUBLIC_URL=

# Optional page analytics with Umami: the address of your Umami server and the id this site has on it.
# Leave either out and the pages load no analytics. UMAMI_RECORDER=on also loads Umami's recorder, which
# replays visits, on the home page and the docs, never in the Studio.
# UMAMI_URL=https://stats.example.com
# UMAMI_WEBSITE_ID=
# UMAMI_RECORDER=on

# Optional: who runs this server, named on the privacy policy and the terms at /privacy and /terms,
# and the address people write to about their data. Without them those pages say "the person who
# runs this server".
# OPERATOR_NAME=
# CONTACT_EMAIL=

# Optional, with a CDN or a second proxy in front of your reverse proxy: the request header it puts the
# visitor's address in. Sign-in attempts are counted per address, and without this they all count against
# that service. Set it only when every request comes through that service: anyone else could send the
# header themselves.
# CLIENT_IP_HEADER=CF-Connecting-IP

# Optional caps for every account other than the admin.
# USER_MAX_PROJECTS=20
# USER_MAX_SHOTS=40
# Renders each of them gets. One export is one render. On the Admin page you can give an account more.
# USER_RENDER_CREDITS=10

# Optional: the proxies whose X-Forwarded-For and X-Forwarded-Proto are believed. The default trusts this
# machine and private networks, which covers a reverse proxy on the host or in Docker. docker-compose.yaml
# keeps the default; add the variable to its environment list to change it there. With no proxy in front,
# set false; for a proxy on a public or 100.64.0.0/10 address, add its address or range.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Optional: more names the server answers to, besides localhost, IP addresses and the host of PUBLIC_URL.
# Checked always while sign-in is off, and with sign-in on once it is set.
# ALLOWED_HOSTS=appshots.lan

# Local runs only (npm start).
# PORT=3000
# HOST=127.0.0.1
# DATA_DIR=data

# Optional, the renderer, for a server you start yourself: docker-compose.yaml leaves these at their defaults.
# Renders drawn at the same time, each in a browser window of its own.
# RENDER_CONCURRENCY=1
# Starts the browser with the server; off starts it with the first render.
# RENDER_PREWARM=on
# PNG compression of the rendered files, 0 to 9. Lower is faster and makes larger files.
# RENDER_PNG_LEVEL=9
