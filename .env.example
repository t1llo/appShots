# Access token for the web gallery, the REST API, the CLI and the MCP endpoint.
# Generate one with: openssl rand -hex 32
SHOTS_TOKEN=

# Optional: the public origin, e.g. https://shots.example.com. Leave empty to use whatever
# origin each request arrives on.
PUBLIC_URL=

# Local runs only (npm start).
# PORT=3000
# DATA_DIR=data
