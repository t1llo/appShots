# The owner's token: it signs you in to the web gallery and is the bearer token for your own
# Claude (MCP) and CLI. Other people get accounts with their own tokens.
# Generate one with: openssl rand -hex 32
APPSHOTS_TOKEN=

# The public origin, e.g. https://appshots.example.com. Used in invite and reset links, in the
# links Claude gets back and as the Google redirect. Empty falls back to each request's host.
PUBLIC_URL=

# Optional: "Continue with Google" on the sign-in page. Create an OAuth client (type "Web
# application") in Google Cloud Console and add this authorised redirect URI:
#   <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional caps for every account other than the owner.
# USER_MAX_PROJECTS=20
# USER_MAX_SHOTS=40

# Local runs only (npm start).
# PORT=3000
# DATA_DIR=data
